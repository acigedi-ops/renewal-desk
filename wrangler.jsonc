// Lets Cloudflare deploy this with no settings typed in: `npx wrangler deploy` runs the build, then uploads dist/.
{
  "name": "renewal-desk",
  "compatibility_date": "2025-09-01",
  "build": {"command": "node build.mjs"},
  "assets": {"directory": "./dist", "not_found_handling": "single-page-application"}
}
